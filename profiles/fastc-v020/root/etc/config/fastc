config main 'main'
	option version '0.2.0-dev'
	option enabled '0'
	option mode 'fastacl'
	option engine 'mihomo'
	option core_path '/usr/bin/mihomo'
	option dataplane 'tproxy'
	option tun_enabled '0'
	option hot_switch '1'
	option exclusive_binding '1'
	option fail_closed '1'
	option dns_hijack '1'
	option dns_via_proxy '1'
	option ui_exit_panel 'collapsed'
	option guard_interval '15'
	option controller '127.0.0.1:9097'
	option tproxy_port '7895'
	option dns_port '1053'
	option node_probe_port '18200'
	option mark '0x67'
	option route_table '101'
	option bindings_db '/etc/fastc/bindings.json'
	option chains_db '/etc/fastc/chains.json'
	option nodes_db '/etc/fastc/nodes.json'
	option topology_db '/etc/fastc/topology.json'
	option last_good_db '/etc/fastc/last-good.json'
