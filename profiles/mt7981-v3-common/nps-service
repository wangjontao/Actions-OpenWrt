#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_client() {
  local section="$1" enabled server port vkey proto level
  config_get_bool enabled "$section" enabled 1
  [ "$enabled" = 1 ] || return 0
  config_get server "$section" server_addr
  config_get port "$section" server_port 8024
  config_get vkey "$section" vkey
  config_get proto "$section" protocol tcp
  config_get level "$section" log_level 4
  [ -n "$server" ] && [ -n "$vkey" ] || { logger -t nps 'Missing server or vkey; client not started'; return 1; }
  case "$port" in ''|*[!0-9]*) return 1;; esac
  [ "$port" -gt 0 ] && [ "$port" -le 65535 ] || return 1
  case "$proto" in tcp|kcp) ;; *) proto=tcp;; esac
  procd_open_instance "$section"
  procd_set_param command /usr/bin/npc -server "$server:$port" -vkey "$vkey" -type "$proto" -log stdout -log_level "$level"
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 1
  procd_set_param stderr 1
  procd_set_param file /etc/config/nps
  procd_close_instance
}
start_service() {
  [ -x /usr/bin/npc ] || return 1
  config_load nps
  config_foreach start_client nps
}
service_triggers() { procd_add_reload_trigger nps; }
