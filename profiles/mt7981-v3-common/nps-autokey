#!/bin/sh /etc/rc.common
START=94
DONE=/etc/nps-wan-mac.done
get_wan_mac() {
  local dev mac
  for dev in "$(uci -q get network.wan.device)" "$(uci -q get network.wan.ifname)" "$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.device' 2>/dev/null)" wan eth1 eth0; do
    [ -n "$dev" ] && [ -r "/sys/class/net/$dev/address" ] || continue
    mac="$(cat "/sys/class/net/$dev/address")"
    case "$mac" in ''|00:00:00:00:00:00) continue;; esac
    echo "$mac"; return 0
  done
  return 1
}
update_nps_key() {
  local mac key server
  server='NPS_DOMAIN'
  mac="$(get_wan_mac)" || { logger -t nps-autokey 'WAN MAC unavailable; will retry on WAN ifup'; return 1; }
  key="$(printf '%s' "$mac" | tr -d ':' | tr 'ABCDEF' 'abcdef')"
  [ "${#key}" = 12 ] || return 1
  case "$key" in *[!0-9a-f]*) return 1;; esac
  # Preserve custom identities, but migrate the earlier uppercase WAN-MAC default.
  local current upper
  current="$(uci -q get nps.@nps[0].vkey)"
  if [ -n "$(uci -q get nps.@nps[0].server_addr)" ] && [ -n "$current" ]; then
    upper="$(printf '%s' "$key" | tr 'abcdef' 'ABCDEF')"
    if [ "$current" = "$upper" ] && [ "$current" != "$key" ]; then
      uci set "nps.@nps[0].vkey=$key" && uci commit nps || return 1
      chmod 600 /etc/config/nps
      if [ -s /etc/npc.conf ] && grep -Fqx "vkey=$upper" /etc/npc.conf; then
        sed -i "s/^vkey=$upper$/vkey=$key/" /etc/npc.conf
        chmod 600 /etc/npc.conf
      fi
      logger -t nps-autokey 'Migrated WAN-MAC vkey to lowercase'
    fi
    touch "$DONE"; return 0
  fi
  [ -e /etc/config/nps ] || touch /etc/config/nps
  uci -q get nps.@nps[0] >/dev/null || uci add nps nps >/dev/null || return 1
  uci set nps.@nps[0].enabled='1' &&
  uci set "nps.@nps[0].server_addr=$server" &&
  uci set nps.@nps[0].server_port='8024' &&
  uci set nps.@nps[0].protocol='tcp' &&
  uci set nps.@nps[0].log_level='4' &&
  uci set nps.@nps[0].compress='1' &&
  uci set nps.@nps[0].crypt='1' &&
  uci set "nps.@nps[0].vkey=$key" && uci commit nps || return 1
  chmod 600 /etc/config/nps
  [ "$(uci -q get nps.@nps[0].vkey)" = "$key" ] || return 1
  touch "$DONE"
  logger -t nps-autokey "Initialized $server:8024 from WAN MAC"
}
start() { update_nps_key; }
boot() { update_nps_key; }
