#!/bin/sh
set -eu

DP="/usr/bin/fastc-dataplane"
GEN="/usr/libexec/fastc-generate.lua"
SYNC="/usr/libexec/fastc-sync.lua"
RELOAD="/usr/libexec/fastc-reload.lua"
LOCK="/tmp/fastc-transaction.lock"

log(){ echo "[FastC-MODE] $*"; }
api_ready(){ curl -fsS --connect-timeout 1 --max-time 1 http://127.0.0.1:9097/version >/dev/null 2>&1; }

core_healthy(){
  pidof mihomo >/dev/null 2>&1 || return 1
  api_ready || return 1
  "$DP" listeners >/dev/null 2>&1
}

sync_selectors(){
  [ -x "$SYNC" ] || return 1
  lua "$SYNC" >/tmp/fastc-sync-mode.json 2>/tmp/fastc-sync-mode.log || {
    log "mihomo selector sync failed"
    cat /tmp/fastc-sync-mode.log 2>/dev/null || true
    cat /tmp/fastc-sync-mode.json 2>/dev/null || true
    return 1
  }
}

prepare_core(){
  lua "$GEN" >/tmp/fastc-generate.json 2>/tmp/fastc-generate.log || {
    log "config generation failed"; cat /tmp/fastc-generate.log 2>/dev/null || true; return 1;
  }
  /usr/bin/mihomo -t -d /etc/fastc -f /etc/fastc/config.yaml >/tmp/fastc-mihomo-check.log 2>&1 || {
    log "mihomo config check failed"; cat /tmp/fastc-mihomo-check.log 2>/dev/null || true; return 1;
  }

  if pidof mihomo >/dev/null 2>&1 && api_ready; then
    oldpid="$(pidof mihomo)"
    log "mihomo is live; applying config with API hot reload (PID $oldpid)"
    lua "$RELOAD" >/tmp/fastc-mode-reload.json 2>/tmp/fastc-mode-reload.log || {
      log "mihomo hot reload failed"; cat /tmp/fastc-mode-reload.log 2>/dev/null || true; cat /tmp/fastc-mode-reload.json 2>/dev/null || true; return 1;
    }
    newpid="$(pidof mihomo 2>/dev/null || true)"
    [ "$oldpid" = "$newpid" ] || { log "mihomo PID changed unexpectedly: $oldpid -> $newpid"; return 1; }
  else
    log "mihomo is not running; starting it once"
    /etc/init.d/fastc enable >/dev/null 2>&1 || true
    /etc/init.d/fastc start >/tmp/fastc-start.log 2>&1 || true
  fi

  i=0
  while [ "$i" -lt 15 ]; do
    if core_healthy; then sync_selectors || return 1; return 0; fi
    sleep 1; i=$((i+1))
  done
  log "FastC per-AP listeners did not become ready"
  "$DP" status 2>/dev/null || true
  cat /tmp/fastc-start.log 2>/dev/null || true
  cat /tmp/fastc-mihomo-check.log 2>/dev/null || true
  return 1
}

stop_fastacl_dataplane(){
  uci set juliang_fastacl.main.enabled='0'
  uci commit juliang_fastacl
  /etc/init.d/juliang-fastacl disable >/dev/null 2>&1 || true
  /etc/init.d/juliang-fastacl stop >/dev/null 2>&1 || true
  /usr/bin/juliang-fastacl stop >/dev/null 2>&1 || true
  nft list table inet juliang_fastacl >/dev/null 2>&1 && nft delete table inet juliang_fastacl >/dev/null 2>&1 || true
  ip rule del fwmark 0x66/0xff table 100 priority 10000 >/dev/null 2>&1 || true
  ip route flush table 100 >/dev/null 2>&1 || true
  nft list table inet juliang_fastacl >/dev/null 2>&1 && return 1 || true
  ip rule show 2>/dev/null | grep -q 'fwmark 0x66/0xff.*lookup 100' && return 1 || true
  return 0
}

restore_fastacl(){
  log "restoring FastACL..."
  "$DP" down >/dev/null 2>&1 || true
  uci set juliang_fastacl.main.enabled='1'
  uci commit juliang_fastacl
  /etc/init.d/juliang-fastacl enable >/dev/null 2>&1 || true
  if ! /usr/bin/juliang-fastacl repair >/tmp/fastc-rollback-fastacl.log 2>&1; then
    log "FastACL repair failed during rollback"
    cat /tmp/fastc-rollback-fastacl.log 2>/dev/null || true
    return 1
  fi
  /etc/init.d/juliang-fastacl restart >/dev/null 2>&1 || true
  sleep 1
  nft list table inet juliang_fastacl >/dev/null 2>&1 || return 1
  nft list table inet juliang_killswitch >/dev/null 2>&1 || return 1
  /usr/bin/juliang-fastacl status 2>/dev/null | grep -q '^router: running' || return 1
  [ "$("$DP" owner)" = "fastacl" ] || return 1
  "$DP" release >/dev/null 2>&1 || true
  uci set fastc.main.mode='fastacl'
  uci set fastc.main.enabled='0'
  uci commit fastc
  echo fastacl > /tmp/juliang-dataplane.owner
  return 0
}

switch_fastc(){
  [ -x /usr/bin/mihomo ] || { log "mihomo core missing"; return 1; }
  [ -x "$DP" ] || { log "FastC dataplane helper missing"; return 1; }
  touch "$LOCK"
  trap 'rm -f "$LOCK"' EXIT INT TERM

  log "1/8 generating and hot-preloading FastC while FastACL stays online..."
  prepare_core || return 1

  log "2/8 validating every discovered per-AP TProxy listener..."
  "$DP" listeners || return 1

  log "3/8 installing FastC fail-closed guard..."
  "$DP" killswitch || return 1

  log "4/8 releasing FastACL TProxy while keeping fail-closed protection..."
  if ! stop_fastacl_dataplane; then
    log "FastACL dataplane did not release cleanly; refusing dual-owner state"
    restore_fastacl || true
    return 1
  fi

  log "5/8 installing FastC per-AP TProxy rules + fwmark route..."
  if ! "$DP" up; then
    log "FastC dataplane activation failed; rolling back to FastACL"
    restore_fastacl || true
    return 1
  fi

  log "6/8 validating FastC owner, selectors and dataplane..."
  if [ "$("$DP" owner)" != "fastc" ] || ! core_healthy || ! sync_selectors || ! "$DP" check; then
    log "FastC validation failed; rolling back to FastACL"
    restore_fastacl || true
    return 1
  fi

  log "7/8 committing FastC as the only dataplane owner..."
  uci set fastc.main.mode='fastc'
  uci set fastc.main.enabled='1'
  uci commit fastc
  echo fastc > /tmp/juliang-dataplane.owner

  log "8/8 releasing old FastACL kill-switch after final health check..."
  if [ "$("$DP" owner)" != "fastc" ] || ! core_healthy || ! sync_selectors || ! "$DP" check; then
    log "FastC lost health after commit; rolling back to FastACL"
    restore_fastacl || true
    return 1
  fi
  nft list table inet juliang_killswitch >/dev/null 2>&1 && nft delete table inet juliang_killswitch >/dev/null 2>&1 || true
  rm -f "$LOCK"
  trap - EXIT INT TERM
  log "FastC now exclusively owns discovered wireless traffic"
}

switch_fastacl(){
  [ -x "$DP" ] || return 1
  touch "$LOCK"
  trap 'rm -f "$LOCK"' EXIT INT TERM

  log "1/5 installing FastC fail-closed guard during handoff..."
  "$DP" killswitch || return 1
  log "2/5 removing FastC TProxy interception but keeping guard..."
  "$DP" down || true
  log "3/5 rebuilding FastACL dataplane..."
  uci set juliang_fastacl.main.enabled='1'
  uci commit juliang_fastacl
  /etc/init.d/juliang-fastacl enable >/dev/null 2>&1 || true
  if ! /usr/bin/juliang-fastacl repair >/tmp/fastc-fastacl-restore.log 2>&1; then
    log "FastACL repair failed; FastC guard remains closed"
    cat /tmp/fastc-fastacl-restore.log 2>/dev/null || true
    return 1
  fi
  /etc/init.d/juliang-fastacl restart >/dev/null 2>&1 || true
  sleep 1
  log "4/5 validating FastACL as sole dataplane owner..."
  nft list table inet juliang_fastacl >/dev/null 2>&1 || return 1
  nft list table inet juliang_killswitch >/dev/null 2>&1 || return 1
  /usr/bin/juliang-fastacl status 2>/dev/null | grep -q '^router: running' || return 1
  [ "$("$DP" owner)" = "fastacl" ] || return 1
  log "5/5 releasing FastC guard and committing mode..."
  "$DP" release >/dev/null 2>&1 || true
  uci set fastc.main.mode='fastacl'
  uci set fastc.main.enabled='0'
  uci commit fastc
  echo fastacl > /tmp/juliang-dataplane.owner
  rm -f "$LOCK"
  trap - EXIT INT TERM
  log "FastACL now exclusively owns traffic"
}

status(){
  echo "mode=$(uci -q get fastc.main.mode 2>/dev/null || echo fastacl)"
  echo "owner=$("$DP" owner 2>/dev/null || echo unknown)"
  echo "mihomo=$(pidof mihomo >/dev/null 2>&1 && echo 1 || echo 0)"
  echo "listeners=$("$DP" listeners >/dev/null 2>&1 && echo 1 || echo 0)"
  echo "fastc_tproxy=$(nft list table inet fastc_tproxy >/dev/null 2>&1 && echo 1 || echo 0)"
  echo "fastc_killswitch=$(nft list table inet fastc_killswitch >/dev/null 2>&1 && echo 1 || echo 0)"
  echo "fastacl_tproxy=$(nft list table inet juliang_fastacl >/dev/null 2>&1 && echo 1 || echo 0)"
  echo "fastacl_killswitch=$(nft list table inet juliang_killswitch >/dev/null 2>&1 && echo 1 || echo 0)"
}

case "${1:-status}" in
  fastc) switch_fastc ;;
  fastacl) switch_fastacl ;;
  status) status ;;
  *) echo "Usage: $0 {fastc|fastacl|status}" >&2; exit 2 ;;
esac
