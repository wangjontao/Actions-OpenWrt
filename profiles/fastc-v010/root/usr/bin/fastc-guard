#!/bin/sh
set -u

DP="/usr/bin/fastc-dataplane"
MODE="/usr/bin/fastc-mode"
LOG="/tmp/fastc-guard.log"
FAIL="/tmp/fastc-guard.fail"

log(){ echo "$(date '+%F %T') [FastC-GUARD] $*" >> "$LOG"; }

healthy(){
  [ "$(uci -q get fastc.main.mode 2>/dev/null || echo fastacl)" = "fastc" ] || return 1
  pidof mihomo >/dev/null 2>&1 || return 1
  "$DP" check >/dev/null 2>&1 || return 1
  return 0
}

heal(){
  "$DP" killswitch >/dev/null 2>&1 || return 1
  /etc/init.d/fastc restart >/tmp/fastc-guard-restart.log 2>&1 || true
  sleep 3
  pidof mihomo >/dev/null 2>&1 || return 1
  "$DP" up >/tmp/fastc-guard-dataplane.log 2>&1 || return 1
  "$DP" check >/dev/null 2>&1
}

sleep 8
while true; do
  mode="$(uci -q get fastc.main.mode 2>/dev/null || echo fastacl)"
  if [ "$mode" != "fastc" ]; then
    rm -f "$FAIL" 2>/dev/null || true
    sleep 5
    continue
  fi

  if healthy; then
    rm -f "$FAIL" 2>/dev/null || true
    sleep 5
    continue
  fi

  n="$(cat "$FAIL" 2>/dev/null || echo 0)"
  case "$n" in ''|*[!0-9]*) n=0 ;; esac
  n=$((n+1))
  echo "$n" > "$FAIL"
  log "dataplane unhealthy, recovery attempt $n"

  if heal; then
    log "FastC dataplane recovered"
    rm -f "$FAIL" 2>/dev/null || true
    sleep 5
    continue
  fi

  if [ "$n" -ge 3 ]; then
    log "three recovery attempts failed; rolling back to FastACL"
    "$DP" killswitch >/dev/null 2>&1 || true
    if "$MODE" fastacl >/tmp/fastc-guard-rollback.log 2>&1; then
      log "rollback to FastACL succeeded"
      rm -f "$FAIL" 2>/dev/null || true
    else
      log "rollback failed; fail-closed guard retained"
    fi
  fi
  sleep 5
done
