#!/bin/sh
set -u

DP="/usr/bin/fastc-dataplane"
SYNC="/usr/libexec/fastc-sync.lua"
LOG="/tmp/fastc-guard.log"
FAIL="/tmp/fastc-guard.fail"
LOCK="/tmp/fastc-transaction.lock"
INTERVAL="$(uci -q get fastc.main.guard_interval 2>/dev/null || echo 15)"
case "$INTERVAL" in ''|*[!0-9]*) INTERVAL=15 ;; esac
[ "$INTERVAL" -ge 10 ] 2>/dev/null || INTERVAL=10

log(){
  [ -f "$LOG" ] && [ "$(wc -c < "$LOG" 2>/dev/null || echo 0)" -gt 65536 ] && tail -n 200 "$LOG" > "$LOG.tmp" 2>/dev/null && mv -f "$LOG.tmp" "$LOG"
  echo "$(date '+%F %T') [FastC-GUARD] $*" >> "$LOG"
}
api_ready(){ curl -fsS --connect-timeout 1 --max-time 1 http://127.0.0.1:9097/version >/dev/null 2>&1; }
selectors_ok(){ [ -x "$SYNC" ] && lua "$SYNC" >/tmp/fastc-guard-sync.json 2>/tmp/fastc-guard-sync.log; }
healthy(){
  [ "$(uci -q get fastc.main.mode 2>/dev/null || echo fastc)" = "fastc" ] || return 1
  pidof mihomo >/dev/null 2>&1 || return 1
  api_ready || return 1
  "$DP" check >/dev/null 2>&1 || return 1
  selectors_ok || return 1
  return 0
}
heal_without_restart(){
  # Development rule: never restart a live mihomo instance.
  pidof mihomo >/dev/null 2>&1 || return 2
  api_ready || return 1
  "$DP" killswitch >/dev/null 2>&1 || return 1
  selectors_ok || return 1
  "$DP" up >/tmp/fastc-guard-dataplane.log 2>&1 || return 1
  "$DP" check >/dev/null 2>&1
}
start_only_if_dead(){
  pidof mihomo >/dev/null 2>&1 && return 0
  /etc/init.d/fastc start >/tmp/fastc-guard-start.log 2>&1 || return 1
  sleep 2
  pidof mihomo >/dev/null 2>&1 && api_ready
}

sleep 8
while true; do
  mode="$(uci -q get fastc.main.mode 2>/dev/null || echo fastc)"
  if [ "$mode" != "fastc" ]; then rm -f "$FAIL" 2>/dev/null || true; sleep "$INTERVAL"; continue; fi
  if [ -e "$LOCK" ]; then sleep "$INTERVAL"; continue; fi

  if healthy; then rm -f "$FAIL" 2>/dev/null || true; sleep "$INTERVAL"; continue; fi

  n="$(cat "$FAIL" 2>/dev/null || echo 0)"; case "$n" in ''|*[!0-9]*) n=0 ;; esac; n=$((n+1)); echo "$n" > "$FAIL"
  log "health drift detected, hot recovery attempt $n"

  if pidof mihomo >/dev/null 2>&1; then
    if heal_without_restart; then log "hot recovery succeeded without mihomo restart"; rm -f "$FAIL" 2>/dev/null || true; sleep "$INTERVAL"; continue; fi
  else
    log "mihomo process is actually dead; starting service once"
    if start_only_if_dead && "$DP" up >/tmp/fastc-guard-dataplane.log 2>&1 && selectors_ok; then log "dead core recovered by start"; rm -f "$FAIL" 2>/dev/null || true; sleep "$INTERVAL"; continue; fi
  fi

  # Standalone FastC development mode: never wake or repair FastACL.
  # Keep the FastC kill-switch closed so broken proxy state cannot leak to WAN.
  "$DP" killswitch >/dev/null 2>&1 || true
  if [ "$n" -ge 3 ]; then
    log "three recovery attempts failed; standalone mode remains fail-closed (no FastACL fallback)"
  fi
  sleep "$INTERVAL"
done
