#!/bin/sh /etc/rc.common

USE_PROCD=1
START=94
STOP=10

PROG="/usr/bin/mihomo"
CFG_DIR="/etc/fastc"
CFG_FILE="/etc/fastc/config.yaml"
GEN="/usr/libexec/fastc-generate.lua"
DP="/usr/bin/fastc-dataplane"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -x "$GEN" ] || return 1

	lua "$GEN" >/tmp/fastc-generate.json 2>/tmp/fastc-generate.log || return 1
	[ -s "$CFG_FILE" ] || return 1
	"$PROG" -t -d "$CFG_DIR" -f "$CFG_FILE" >/tmp/fastc-mihomo-check.log 2>&1 || return 1

	mode="$(uci -q get fastc.main.mode 2>/dev/null || echo fastacl)"
	if [ "$mode" = "fastc" ] && [ -x "$DP" ]; then
		# Fail closed before the mihomo process and transparent rules are restored.
		"$DP" killswitch >/tmp/fastc-boot-killswitch.log 2>&1 || return 1
	fi

	procd_open_instance main
	procd_set_param command "$PROG" -d "$CFG_DIR" -f "$CFG_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ "$mode" = "fastc" ] && [ -x "$DP" ]; then
		# One-shot delayed restore: by this point the TProxy listener should exist.
		procd_open_instance dataplane
		procd_set_param command /bin/sh -c "sleep 2; /usr/bin/fastc-dataplane up >/tmp/fastc-boot-dataplane.log 2>&1"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger fastc
}
