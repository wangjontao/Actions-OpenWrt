#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

PROG="/usr/bin/mihomo"
CFG_DIR="/etc/fastc"
CFG_FILE="/etc/fastc/config.yaml"
GEN="/usr/libexec/fastc-generate.lua"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -x "$GEN" ] || return 1

	lua "$GEN" >/tmp/fastc-generate.json 2>/tmp/fastc-generate.log || return 1
	[ -s "$CFG_FILE" ] || return 1

	"$PROG" -t -d "$CFG_DIR" -f "$CFG_FILE" >/tmp/fastc-mihomo-check.log 2>&1 || return 1

	procd_open_instance
	procd_set_param command "$PROG" -d "$CFG_DIR" -f "$CFG_FILE"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger fastc
}
