#!/bin/sh /etc/rc.common

USE_PROCD=1
START=94
STOP=10

PROG="/usr/bin/mihomo"
CFG_DIR="/etc/fastc"
CFG_FILE="/etc/fastc/config.yaml"
GEN="/usr/libexec/fastc-generate.lua"
RELOAD="/usr/libexec/fastc-reload.lua"
SYNC="/usr/libexec/fastc-sync.lua"
DP="/usr/bin/fastc-dataplane"
GUARD="/usr/bin/fastc-guard"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -x "$GEN" ] || return 1

	lua "$GEN" >/tmp/fastc-generate.json 2>/tmp/fastc-generate.log || return 1
	[ -s "$CFG_FILE" ] || return 1
	"$PROG" -t -d "$CFG_DIR" -f "$CFG_FILE" >/tmp/fastc-mihomo-check.log 2>&1 || return 1

	mode="$(uci -q get fastc.main.mode 2>/dev/null || echo fastc)"
	if [ "$mode" = "fastc" ] && [ -x "$DP" ]; then
		"$DP" killswitch >/tmp/fastc-boot-killswitch.log 2>&1 || return 1
	fi

	procd_open_instance main
	procd_set_param command "$PROG" -d "$CFG_DIR" -f "$CFG_FILE"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ -x "$SYNC" ]; then
		procd_open_instance selector_sync
		procd_set_param command /bin/sh -c "sleep 1; lua /usr/libexec/fastc-sync.lua >/tmp/fastc-sync-start.json 2>/tmp/fastc-sync-start.log"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	if [ -x "$GUARD" ]; then
		procd_open_instance guardian
		procd_set_param command "$GUARD"
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	if [ "$mode" = "fastc" ] && [ -x "$DP" ]; then
		procd_open_instance dataplane
		procd_set_param command /bin/sh -c "sleep 3; /usr/bin/fastc-dataplane up >/tmp/fastc-boot-dataplane.log 2>&1"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

reload_service() {
	# FastC development rule: never restart a live mihomo just to apply config.
	# Regenerate, validate, hot-reload over the mihomo API, then resync selectors.
	[ -x "$GEN" ] || return 1
	lua "$GEN" >/tmp/fastc-reload-generate.json 2>/tmp/fastc-reload-generate.log || return 1
	"$PROG" -t -d "$CFG_DIR" -f "$CFG_FILE" >/tmp/fastc-reload-check.log 2>&1 || return 1
	if pidof mihomo >/dev/null 2>&1 && curl -fsS --connect-timeout 1 --max-time 1 http://127.0.0.1:9097/version >/dev/null 2>&1; then
		lua "$RELOAD" >/tmp/fastc-service-reload.json 2>/tmp/fastc-service-reload.log || return 1
		[ -x "$SYNC" ] && lua "$SYNC" >/tmp/fastc-service-sync.json 2>/tmp/fastc-service-sync.log || true
		[ -x "$DP" ] && "$DP" up >/tmp/fastc-service-dataplane.log 2>&1 || true
		return 0
	fi
	# If the core is really dead, procd start is allowed once.
	start
}

# No automatic FastACL interaction. FastC owns its own lifecycle during development.
