#!/bin/sh /etc/rc.common

USE_PROCD=1
START=94
STOP=10

PROG="/usr/bin/mihomo"
CFG_DIR="/etc/fastc"
CFG_FILE="/etc/fastc/config.yaml"
GEN="/usr/libexec/fastc-generate.lua"
DP="/usr/bin/fastc-dataplane"
GUARD="/usr/bin/fastc-guard"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -x "$GEN" ] || return 1

	lua "$GEN" >/tmp/fastc-generate.json 2>/tmp/fastc-generate.log || return 1
	[ -s "$CFG_FILE" ] || return 1
	"$PROG" -t -d "$CFG_DIR" -f "$CFG_FILE" >/tmp/fastc-mihomo-check.log 2>&1 || return 1

	mode="$(uci -q get fastc.main.mode 2>/dev/null || echo fastacl)"
	if [ "$mode" = "fastc" ] && [ -x "$DP" ]; then
		"$DP" killswitch >/tmp/fastc-boot-killswitch.log 2>&1 || return 1
	fi

	procd_open_instance main
	procd_set_param command "$PROG" -d "$CFG_DIR" -f "$CFG_FILE"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	if [ -x "$GUARD" ]; then
		procd_open_instance guardian
		procd_set_param command "$GUARD"
		procd_set_param respawn 3600 5 0
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi

	if [ "$mode" = "fastc" ] && [ -x "$DP" ]; then
		procd_open_instance dataplane
		procd_set_param command /bin/sh -c "sleep 2; /usr/bin/fastc-dataplane up >/tmp/fastc-boot-dataplane.log 2>&1"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_close_instance
	fi
}

reload_service() {
	stop
	start
}

# Do not register a UCI reload trigger here. FastC changes mode/group selection
# explicitly and validates each restart. An asynchronous reload after committing
# fastc.main.mode can otherwise race the handoff and leave mode=fastc with a
# stopped mihomo process.
