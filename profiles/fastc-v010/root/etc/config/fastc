config main 'main'
	option enabled '0'
	option version '0.2.1-dev'
	option core 'mihomo'
	option core_path '/usr/bin/mihomo'
	option core_version '1.19.32'
	option config_path '/etc/fastc/config.yaml'
	option node_db '/etc/fastc/nodes.json'
	option binding_db '/etc/fastc/bindings.json'
	option chain_db '/etc/fastc/chains.json'
	option topology_path '/etc/fastc/topology.json'
	option controller '127.0.0.1:9097'
	option dataplane 'tproxy'
	option tun_enabled '0'
	option hot_switch '1'
	option exclusive_binding '1'
	option fail_closed '1'
	option dns_hijack '1'
	option dns_via_proxy '1'
	option ui_exit_panel 'collapsed'
	option tproxy_port '7895'
	option ap_tproxy_base '19000'
	option dns_port '1053'
	option node_probe_port '18200'
	option guard_interval '15'
	option mark '0x67'
	option route_table '101'
	option mode 'fastacl'
