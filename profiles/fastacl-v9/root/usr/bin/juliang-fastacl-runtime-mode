#!/bin/sh
set -u

CFG="juliang_fastacl"

json_ok(){ printf '{"ok":true,"mode":"%s"}\n' "$1"; }
json_err(){ printf '{"ok":false,"error":"%s"}\n' "$1"; }

zone_for_network(){
    net="$1"
    for z in $(uci -q show firewall 2>/dev/null | sed -n "s/^firewall\.\([^.=]*\)=zone$/\1/p"); do
        name="$(uci -q get firewall.$z.name 2>/dev/null || true)"
        nets="$(uci -q get firewall.$z.network 2>/dev/null || true)"
        if [ "$name" = "$net" ]; then
            printf '%s\n' "$name"
            return 0
        fi
        for x in $nets; do
            if [ "$x" = "$net" ]; then
                [ -n "$name" ] && printf '%s\n' "$name" || printf '%s\n' "$z"
                return 0
            fi
        done
    done
    return 1
}

remove_plugin_forwardings(){
    changed=0
    for sec in $(uci -q show firewall 2>/dev/null | sed -n "s/^firewall\.\(jfa_plugin_ap[0-9]*\)=forwarding$/\1/p"); do
        uci -q delete firewall.$sec
        changed=1
    done
    if [ "$changed" -eq 1 ]; then
        uci commit firewall
        /etc/init.d/firewall restart >/dev/null 2>&1 || true
    fi
}

restore_plugin_forwardings(){
    changed=0
    for sec in $(uci -q show "$CFG" 2>/dev/null | sed -n "s/^$CFG\.\([^.=]*\)=ap$/\1/p"); do
        n="$(uci -q get $CFG.$sec.slot 2>/dev/null || echo "${sec#ap}")"
        case "$n" in ''|*[!0-9]*) continue ;; esac
        net="$(uci -q get $CFG.$sec.network 2>/dev/null || true)"
        [ -n "$net" ] || continue
        zone="$(zone_for_network "$net" 2>/dev/null || true)"
        [ -n "$zone" ] || continue
        f="jfa_plugin_ap$n"
        if [ "$(uci -q get firewall.$f 2>/dev/null || true)" != "forwarding" ]; then
            uci -q delete firewall.$f >/dev/null 2>&1 || true
            uci set firewall.$f='forwarding'
            changed=1
        fi
        [ "$(uci -q get firewall.$f.src 2>/dev/null || true)" = "$zone" ] || { uci set firewall.$f.src="$zone"; changed=1; }
        [ "$(uci -q get firewall.$f.dest 2>/dev/null || true)" = "wan" ] || { uci set firewall.$f.dest='wan'; changed=1; }
    done
    if [ "$changed" -eq 1 ]; then
        uci commit firewall
        /etc/init.d/firewall restart >/dev/null 2>&1 || true
    fi
}

stop_fastacl(){
    uci set $CFG.main.runtime_mode='normal_proxy'
    uci set $CFG.main.enabled='0'
    uci commit "$CFG"

    /etc/init.d/juliang-fastacl stop >/dev/null 2>&1 || true
    /etc/init.d/juliang-fastacl disable >/dev/null 2>&1 || true
    /usr/bin/juliang-fastacl stop >/dev/null 2>&1 || true

    nft delete table inet juliang_fastacl >/dev/null 2>&1 || true
    nft delete table inet juliang_killswitch >/dev/null 2>&1 || true
    while ip rule del fwmark 0x66/0xff table 100 >/dev/null 2>&1; do :; done
    ip route flush table 100 >/dev/null 2>&1 || true

    restore_plugin_forwardings
    json_ok normal_proxy
}

start_fastacl(){
    remove_plugin_forwardings

    uci set $CFG.main.runtime_mode='fastacl'
    uci set $CFG.main.enabled='1'
    uci commit "$CFG"

    # FastACL owns the dataplane in this mode. PassWall2 remains node DB/UI only.
    if uci -q get passwall2.@global[0] >/dev/null 2>&1; then
        uci -q set passwall2.@global[0].enabled='0'
        uci -q set passwall2.@global[0].acl_enable='0'
        uci -q set passwall2.@global[0].socks_enabled='0'
        uci commit passwall2
    fi
    /etc/init.d/passwall2 stop >/dev/null 2>&1 || true
    /etc/init.d/passwall2 disable >/dev/null 2>&1 || true

    /etc/init.d/juliang-fastacl enable >/dev/null 2>&1 || true
    if /etc/init.d/juliang-fastacl restart >/tmp/juliang-fastacl/runtime-mode-start.log 2>&1; then
        /usr/bin/juliang-fastacl repair >/tmp/juliang-fastacl/runtime-mode-repair.log 2>&1 || true
        json_ok fastacl
        return 0
    fi

    json_err FASTACL_START_FAILED
    return 1
}

status(){
    mode="$(uci -q get $CFG.main.runtime_mode 2>/dev/null || true)"
    enabled="$(uci -q get $CFG.main.enabled 2>/dev/null || echo 0)"
    if [ "$mode" = "normal_proxy" ] || [ "$enabled" != "1" ]; then
        json_ok normal_proxy
    else
        json_ok fastacl
    fi
}

case "${1:-status}" in
    status) status ;;
    fastacl) start_fastacl ;;
    normal_proxy) stop_fastacl ;;
    *) echo "Usage: juliang-fastacl-runtime-mode {status|fastacl|normal_proxy}"; exit 2 ;;
esac
