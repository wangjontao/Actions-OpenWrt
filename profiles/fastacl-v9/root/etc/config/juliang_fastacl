config main 'main'
	option enabled '1'
	option tproxy_port '12345'
	option mark '0x66'
	option route_table '100'
	option dns_mode 'doh'
	option dns_server '1.1.1.1'
	option dns_tls_server_name 'cloudflare-dns.com'
	option dns_path '/dns-query'
	option version '2.4.4'
	option health_probe_interval '120'
	option health_fail_threshold '3'
	option include_lan '1'
	option runtime_mode 'fastacl'
