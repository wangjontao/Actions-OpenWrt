#!/usr/bin/lua
local sys=require "luci.sys"
local jsonc=require "luci.jsonc"
local uci=require("luci.model.uci").cursor()
local app=arg[1] or ""
if app~="passwall" and app~="passwall2" then io.write('{"status":"BAD_APP"}'); os.exit(1) end

local function rf(p)
  local f=io.open(p,"r"); if not f then return "" end
  local d=f:read("*a") or ""; f:close(); return d
end
local function parse(t)
  local r={status="FAILED",ip="",country="",country_code="",city="",isp="",asn="",port=""}
  for line in (t or ""):gmatch("[^\r\n]+") do
    local k,v=line:match("^([A-Z_]+)=(.*)$")
    if k=="STATUS" then r.status=v elseif k=="PORT" then r.port=v elseif k=="IP" then r.ip=v
    elseif k=="COUNTRY" then r.country=v elseif k=="COUNTRY_CODE" then r.country_code=v
    elseif k=="CITY" then r.city=v elseif k=="ISP" then r.isp=v elseif k=="ASN" then r.asn=v end
  end
  return r
end

local enabled=uci:get(app,"@global[0]","enabled") or "0"
local var=rf("/tmp/etc/"..app.."/var")
local node=var:match('ACL_GLOBAL_node="([^"]+)"') or uci:get(app,"@global[0]","node") or ""
local port
if app=="passwall2" then
  port=tonumber(uci:get(app,"@global[0]","node_socks_port") or "1070") or 1070
else
  port=tonumber(uci:get(app,"@global[0]","tcp_node_socks_port") or uci:get(app,"@global[0]","node_socks_port") or "1070") or 1070
end
local out={status=enabled=="1" and "NO_RUNTIME_NODE" or "DISABLED",node=node,remarks=node~="" and (uci:get(app,node,"remarks") or node) or "",socks_port=port,ip="",country="",country_code="",city="",isp="",asn=""}
if enabled=="1" and node~="" then
  local r=parse(sys.exec("/usr/bin/proxy-socks-ip-probe "..tostring(port).." 2>/dev/null"))
  for k,v in pairs(r) do if k~="port" then out[k]=v end end
end
io.write(jsonc.stringify(out))
