#!/bin/sh
# Retry MAC provisioning when WAN first becomes available.
[ "$ACTION" = "ifup" ] && [ "$INTERFACE" = "wan" ] || exit 0
[ -e /etc/nps-wanmac-initialized ] && exit 0
[ -x /etc/uci-defaults/99-nps-firstboot-mac ] || exit 0
/etc/uci-defaults/99-nps-firstboot-mac && rm -f /etc/uci-defaults/99-nps-firstboot-mac
exit 0
