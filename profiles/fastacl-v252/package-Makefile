include $(TOPDIR)/rules.mk
PKG_NAME:=fastacl252
PKG_VERSION:=2.6.0
PKG_RELEASE:=1
PKG_LICENSE:=AGPL-3.0-only
include $(INCLUDE_DIR)/package.mk
define Package/fastacl252
  SECTION:=net
  CATEGORY:=Network
  TITLE:=JuLiangTK FastACL 2.6.0 dae/eBPF control center
  CONFLICTS:=fastacl25 fastacl251
  DEPENDS:=+kmod-tcp-bbr +kmod-sched +juliangtk-dae +libuci-lua +luci-compat +luci-lib-nixio +luci-lib-jsonc +lyaml +curl +ca-bundle +ip-full +iw +iwinfo +ip-bridge +firewall4 +sqm-scripts +kmod-sched-cake +kmod-ifb
endef
define Build/Compile
endef
define Package/fastacl252/install
	$(CP) ./files/* $(1)/
	test -s $(1)/usr/share/fastacl252/cn-ipv4.txt
	test -s $(1)/usr/share/fastacl252/cn-domains.txt
	$(INSTALL_DIR) $(1)/usr/libexec
	$(LN) ../bin/fastacl252-dns $(1)/usr/libexec/fastacl252-exit-probe
	chmod 755 $(1)/usr/bin/fastacl252-dns $(1)/usr/bin/fastacl252 $(1)/usr/libexec/fastacl252-enable.sh $(1)/usr/libexec/juliang-reboot.sh $(1)/usr/libexec/nps-wan-mac $(1)/etc/init.d/fastacl252 $(1)/etc/init.d/nps-wan-mac $(1)/etc/hotplug.d/iface/99-nps-wan-mac
	if [ -d $(1)/etc/uci-defaults ]; then chmod 755 $(1)/etc/uci-defaults/*; fi
	chmod 755 $(1)/usr/libexec/juliang-bbr $(1)/etc/init.d/juliang-bbr
	chmod 600 $(1)/etc/config/fastacl252
endef
$(eval $(call BuildPackage,fastacl252))

