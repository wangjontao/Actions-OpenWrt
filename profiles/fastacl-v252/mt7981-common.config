# JuLiangTK MT7981 MTWiFi / MediaTek Filogic MT7986A
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# LuCI and Simplified Chinese
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-ipkg=y

# JuLiangTK FastACL 2.5.6 intentionally excludes iStore / QuickStart.
# CONFIG_PACKAGE_luci-app-store is not set
# CONFIG_PACKAGE_luci-app-quickstart is not set
# CONFIG_PACKAGE_quickstart is not set
# CONFIG_PACKAGE_taskd is not set

# Argon theme
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

# Terminal and common LuCI tools
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y
# CONFIG_PACKAGE_luci-app-samba4 is not set
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-autoreboot=y

# LuCI monitoring
# CONFIG_PACKAGE_luci-app-statistics is not set
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-df=y
CONFIG_PACKAGE_collectd-mod-disk=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-iwinfo=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_collectd-mod-rrdtool=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_collectd-mod-uptime=y

# Independent FastACL 2.5.2 dae / fw4 (no other proxy plugins)
CONFIG_PACKAGE_fastacl252=y
CONFIG_PACKAGE_juliangtk-dae=y
CONFIG_PACKAGE_lyaml=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-nixio=y
CONFIG_PACKAGE_firewall4=y
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-homeproxy is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_sing-box is not set

# Source-feed NPS server/client and LuCI UI
CONFIG_PACKAGE_nps=y
CONFIG_PACKAGE_npc=y
CONFIG_PACKAGE_luci-app-nps=y
CONFIG_PACKAGE_luci-i18n-nps-zh-cn=y
# CONFIG_PACKAGE_luci-app-npc is not set

# Runtime
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_CCACHE=y

CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="JuLiangTK"
CONFIG_VERSION_MANUFACTURER="JuLiangTK"
CONFIG_VERSION_PRODUCT="JuLiangTK MT7981 MTWiFi"
CONFIG_VERSION_HWREV="MT7981"
CONFIG_VERSION_CODE="FastACL2.5.6"

# CONFIG_PACKAGE_fastacl25 is not set
# CONFIG_PACKAGE_juliangtk-sing-box is not set
# CONFIG_PACKAGE_dae is not set
